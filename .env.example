# Copy to .env and fill in. Never commit the real .env file.
APP_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database (MySQL is the supported backend) ---
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mlids
MYSQL_PASSWORD=
MYSQL_DATABASE=ml_ids

# --- Uploads ---
MAX_UPLOAD_MB=200

# --- Sessions ---
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false

# --- First administrator (used only by `python app.py init-admin`) ---
# If left empty the command prompts interactively; the password is never stored in code.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
